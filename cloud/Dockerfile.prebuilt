# Packaging a separately built, static, architecture-checked artifact (CI / cross-builds).
FROM scratch
ARG TARGETARCH
COPY --chmod=0555 dist/${TARGETARCH}/lightcraft-cloud /lightcraft-cloud
COPY --chown=10001:10001 docker/runtime/ /data/
USER 10001:10001
ENV LC_STORAGE_ROOT=/data TMPDIR=/tmp
EXPOSE 8080
ENTRYPOINT ["/lightcraft-cloud"]
