# Non-secret deployment settings. Copy to .env and choose your own HTTPS names.
LC_API_IMAGE=lightcraft-cloud:local
LC_AUTH_IMAGE=lightcraft-keycloak:local
LC_AUTH_PUBLIC_URL=https://CHANGE-ME-AUTH.duckdns.org
LC_OIDC_ISSUER=https://CHANGE-ME-AUTH.duckdns.org/realms/lightcraft
LC_ALLOW_HTTP_OIDC=false
# A public HTTPS issuer with JWKS retrieved only across the private Docker network.
LC_OIDC_JWKS_URL=http://lc-auth:8080/realms/lightcraft/protocol/openid-connect/certs
LC_ALLOW_HTTP_JWKS=true
# Set from measured free capacity; this is an example, not an OCI capacity estimate.
LC_STORAGE_QUOTA_BYTES=10737418240
LC_MIN_FREE_BYTES=21474836480
LC_MAX_UPLOAD_BYTES=536870912
